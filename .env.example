# Boop environment template. Copy to `.env.local` (gitignored) and fill in.
#
# IMPORTANT — Docker env_file gotcha:
# When this file is loaded by docker-compose via `env_file: .env.local`, the
# parser treats the entire line after `=` as the value, *including* any inline
# `# comment` text. That breaks API keys ("Invalid API Key" / 503 errors).
# Keep all comments on their own lines. NEVER write `FOO=bar # note` in
# .env.local — write the comment on the previous line instead.

# ---- Convex ----
# Get these by running: npx convex dev
# Convex will create a project and auto-populate your .env.local.
CONVEX_DEPLOYMENT=
CONVEX_URL=
VITE_CONVEX_URL=

# ---- Telegram bot ----
# Create a bot via @BotFather (https://t.me/BotFather) — it gives you a
# token like 1234567:AAH... that goes here.
TELEGRAM_BOT_TOKEN=

# Comma-separated allow-list of Telegram chat ids that can talk to the bot.
# Get your own chat id from @userinfobot (https://t.me/userinfobot).
# *Required for production.* If left blank, the bot will respond to anyone
# who messages it — fine for local testing, dangerous in deployment.
TELEGRAM_ALLOWED_CHAT_IDS=

# Bot lifecycle:
#   polling (default) — outbound long-poll, no public URL needed.
#   webhook           — needs PUBLIC_URL to be a stable HTTPS URL routed to
#                       /telegram/webhook (typically via Traefik / Caddy).
TELEGRAM_MODE=polling

# ---- Claude model (dispatcher + workers + memory extract) ----
# Default: claude-haiku-4-5-20251001 — cheapest Claude available on AgentRouter,
# works fine as a dispatcher. For better quality on complex multi-step tasks
# upgrade to claude-sonnet-4-6 (only available on direct Anthropic, not on
# AgentRouter free tier) or claude-opus-4-6 (available on AgentRouter but
# ~10× more expensive).
# This is the *fallback*; runtime overrides set via the in-bot set_model tool
# (stored in the Convex `settings` table) take precedence.
BOOP_MODEL=claude-haiku-4-5-20251001

# Direct Anthropic API key. Leave blank if you route through AgentRouter
# (set ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN below instead).
# ANTHROPIC_API_KEY=

# ---- AgentRouter (optional — alternative to direct Anthropic API) ----
# AgentRouter (https://agentrouter.org) is a multi-provider proxy. Setting
# ANTHROPIC_BASE_URL routes ALL Anthropic-format calls (dispatcher, workers,
# memory extract) through it. The Claude Agent SDK reads ANTHROPIC_BASE_URL
# and ANTHROPIC_AUTH_TOKEN natively.
# ANTHROPIC_BASE_URL=https://agentrouter.org/
# ANTHROPIC_AUTH_TOKEN=sk-...
# ANTHROPIC_API_KEY=sk-...

# Separate AgentRouter key used for OpenAI-compatible models (glm-5.1, gpt-*,
# deepseek, qwen, etc.) called via server/llm.ts. Same token as above —
# AgentRouter accepts it on both /v1/messages (Anthropic-format) and /v1/chat/
# completions (OpenAI-format) endpoints. Set this to enable GLM-5.1 routing
# on the email classifier and consolidation adversary.
# AGENTROUTER_API_KEY=sk-...
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# ---- Utility model overrides (optional) ----
# When AGENTROUTER_API_KEY is set, the email classifier and consolidation
# adversary default to glm-5.1. Override either to pin a specific model.
# BOOP_CLASSIFIER_MODEL=glm-5.1
# BOOP_ADVERSARY_MODEL=glm-5.1

# ---- Proactive email surfacing ----
# Telegram chat id that receives proactive notices when the Gmail watcher
# decides an inbound email is worth surfacing. Single-user assumption for v1.
# Without this, the webhook still registers but notices are dropped.
BOOP_USER_TG_CHAT_ID=
# Set to "false" to skip auto-registering the Composio webhook URL on each
# `npm run dev`. Use when you want to manage the subscription manually.
# COMPOSIO_AUTO_WEBHOOK=

# ---- Whisper (optional voice transcription) ----
# Telegram voice notes are POSTed to this URL by the Node server. Spin up
# `whisper-service/` (FastAPI + faster-whisper) on the same VM and point
# this at it. Leave blank to disable voice transcription — text still works.
# WHISPER_URL=http://127.0.0.1:9000/transcribe

# ---- Upgrade notifications ----
# On `npm run dev`, Boop checks your `upstream` remote for new commits and
# prints a banner with the commit count + a reminder to run `/upgrade-boop`.
# Set to `false` to silence the check entirely.
# BOOP_UPSTREAM_CHECK=true

# ---- Embeddings (optional — paid providers for memory recall) ----
# Tried in order: Voyage → OpenAI → local Transformers.js (Xenova/bge-large-
# en-v1.5, 1024-dim, free, ~440MB one-time download). Leave both blank to
# use the local fallback. All three produce 1024-dim vectors so the Convex
# index stays compatible regardless of which is active.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# ---- Server ----
PORT=3456

# Public URL for your server. ONLY needed for:
#   * Telegram webhook mode (TELEGRAM_MODE=webhook), or
#   * Composio webhook (proactive Gmail notifications).
# Leave blank if you're using Telegram polling and don't need Composio
# webhooks. With ngrok, leave as http://localhost:3456 — `npm run dev` will
# auto-set this when the tunnel comes up.
PUBLIC_URL=

# Optional: ngrok RESERVED domain (paid plan). Example: "boop.ngrok.app".
# When set, `npm run dev` launches ngrok with --domain=$NGROK_DOMAIN so your
# public URL stays the same across restarts.
# NGROK_DOMAIN=

# ---- Composio (1000+ integrations, zero-code) ----
# Get an API key at https://app.composio.dev/developers.
# Once set, connect toolkits (Gmail, Slack, GitHub, Linear, …) from the
# Debug UI's Connections tab. Each connected toolkit becomes available to
# the agent via spawn_agent(integrations: [...]).
COMPOSIO_API_KEY=

# Optional: stable user id Composio keys connections under. Defaults to
# "boop-default". Override only if you already manage Composio sessions
# elsewhere and want Boop to reuse that user.
# COMPOSIO_USER_ID=

# ---- Perplexity Pro Search (optional) ----
# Reverse-engineered Perplexity Pro Search integration. Routes execution-
# agent web research through Perplexity Sonnet thinking via the same
# endpoint the web UI hits. Disabled when ASOCKS_PROXY_URL is not set —
# without a residential proxy, Cloudflare reliably 403s requests from
# datacenter IPs and burns the cookies. See README.md → "Perplexity Pro
# Search" for the full setup.
#
# asocks.com residential proxy (or any HTTPS / SOCKS5 residential proxy).
# Format: http://USER:PASS@HOST:PORT or socks5://USER:PASS@HOST:PORT
# ASOCKS_PROXY_URL=

# Timezone hint sent on each search. Match this to the residential proxy's
# country to avoid fingerprint anomalies. IANA timezone string.
# PERPLEXITY_TIMEZONE=Europe/Berlin

# Optional override for "cookies expired" alert destination. Defaults to the
# first id in TELEGRAM_ALLOWED_CHAT_IDS — which is what you usually want.
# Only set this if you need alerts to go somewhere different from your main
# chat (e.g. a dedicated #ops channel). Get a chat id from @userinfobot.
# TELEGRAM_ADMIN_CHAT_ID=

# Optional Cloudflare TLS-impersonation fallback. Plain undici fetch through
# the residential proxy is the happy path. Set this to "1" if you start
# seeing systematic Cloudflare 403s on the search endpoint — the client
# will route through cycletls (Chrome JA3 fingerprint). Requires
# `npm install cycletls` first.
# PERPLEXITY_USE_CYCLETLS=

# ---- Perplexity cookie refresh (LOCAL — not needed on the bot's server) ----
# These are read by `npm run refresh-perplexity-cookies` which runs on YOUR
# machine where Dolphin Anty is installed. The bot never sees them.
# DOLPHIN_LOCAL_API=http://localhost:3001
# DOLPHIN_API_TOKEN=
# DOLPHIN_PROFILE_ID=
